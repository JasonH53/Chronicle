{
  "name": "goalify-invest",
  "version": "1.0.0",
  "description": "A web application that demystifies investing for students by anchoring it to their real-life aspirations",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "client": "cd app && npm run dev",
    "server": "nodemon server.js",
    "build": "cd app && npm run build",
    "heroku-postbuild": "cd app && npm install && npm run build",
    "dev:all": "concurrently \"npm run dev\" \"npm run client\""
  },
  "dependencies": {
    "@cerebras/cerebras_cloud_sdk": "^1.50.0",
    "axios": "^1.6.0",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "nodemon": "^3.0.1"
  },
  "keywords": [
    "investing",
    "students",
    "goals",
    "financial-literacy"
  ],
  "author": "Willow Team",
  "license": "MIT"
}
